{
  "name": "dsh-session-purger",
  "version": "0.1.0",
  "type": "module",
  "description": "彻底删除 DSH 会话记录 / Permanently delete DSH session records from the sidebar context menu — log directory, projection cache and workspace registration, with a confirmation dialog.",
  "license": "MIT",
  "author": {
    "name": "595708049",
    "url": "https://github.com/595708049"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/595708049/dsh-session-purger.git"
  },
  "homepage": "https://github.com/595708049/dsh-session-purger#readme",
  "bugs": {
    "url": "https://github.com/595708049/dsh-session-purger/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "session",
    "session-management",
    "cleanup"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "screenshots/"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  }
}
